# Copy to .env.local and fill in from Supabase: Project Settings > API.
# Add the same two values in Vercel: Project Settings > Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or, on older projects, the anon key:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional, Phase 6: error monitoring (Sentry > Project > Client Keys > DSN).
NEXT_PUBLIC_SENTRY_DSN=
# Optional, Phase 6: product analytics (PostHog > Project settings > Project API key).
NEXT_PUBLIC_POSTHOG_KEY=
# EU cloud by default; use https://us.i.posthog.com for a US project.
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Optional: paid plans. Without these, Settings shows "Paid plans are coming soon".
# Server-only secrets: never prefix them with NEXT_PUBLIC_.
# Supabase > Project Settings > API keys > Secret key (sb_secret_...).
SUPABASE_SECRET_KEY=
# Flutterwave > Settings > API keys (use the TEST keys until you go live).
FLW_SECRET_KEY=
# Flutterwave > Settings > Webhooks: the "Secret hash" you choose there.
FLW_WEBHOOK_HASH=
# Flutterwave > Payment plans: ids of "Tickr Standard monthly" ($5 USD) and "yearly" ($48 USD).
FLW_PLAN_MONTHLY=
FLW_PLAN_YEARLY=
